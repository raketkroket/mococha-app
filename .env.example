# Frontend-safe environment variables (safe to expose in browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_INSTAGRAM_URL=https://www.instagram.com/mococha_events/

# WebAuthn / Passkey configuration
# Test domain:
VITE_APP_URL=https://mococha-app.vercel.app
VITE_WEBAUTHN_RP_ID=mococha-app.vercel.app
VITE_WEBAUTHN_RP_NAME=MOCOCHA
# Production:
# VITE_APP_URL=https://app.mococha.nl
# VITE_WEBAUTHN_RP_ID=mococha.nl
# VITE_WEBAUTHN_RP_NAME=MOCOCHA

# Backend-only secrets — set these in Supabase Edge Function secrets, NOT in .env
# SUPABASE_SERVICE_ROLE_KEY (pre-populated in hosted environment)
# MOLLIE_API_KEY
# MOLLIE_WEBHOOK_SECRET
# RESEND_API_KEY
# EMAIL_FROM_ADDRESS
# APP_BASE_URL
